{
  "name": "clubrelay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"green,blue\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "seed": "npm run seed --workspace=server",
    "seed:dev": "npm run seed:dev --workspace=server",
    "db:indexes": "npm run db:indexes --workspace=server",
    "db:check": "npm run db:check --workspace=server",
    "db:local:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:local:down": "docker compose -f docker-compose.dev.yml down",
    "lint": "eslint client/src server/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}

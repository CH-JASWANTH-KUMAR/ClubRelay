# ==============================================================================
# ClubRelay Environment Configuration Template
# ==============================================================================
# IMPORTANT ARCHITECTURE & SECURITY GUIDELINES:
# 1. CLUSTER SEPARATION: Development and production environments MUST use completely
#    separate MongoDB Atlas clusters (or isolated databases), separate database user
#    accounts, and unique strong passwords. Never connect local development to production.
# 2. SCRIPT SAFETY GUARDS: All seeding and cleanup scripts (seed, seed:dev, clean-demo)
#    strictly refuse execution when NODE_ENV is "production" to prevent accidental data loss.
#    Remote Atlas clusters (mongodb+srv) are also blocked unless an explicit ALLOW_*
#    override flag is supplied.
# ==============================================================================

# Node Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Server HTTP Port
PORT=5000

# Authentication Secret (Minimum 32 characters in production)
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters_long!

# MongoDB Connection String (Required in production; optional in dev with in-memory fallback)
# Dev/Local Example:  mongodb://127.0.0.1:27017/clubrelay_dev
# Atlas Example:      mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/clubrelay?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/clubrelay_dev

# CORS Allowed Origin for Frontend Client (comma-separated for multiple origins; production strictly requires explicit production origins, localhost restricted to development)
CLIENT_ORIGIN=http://localhost:5173

# Safety Overrides for Remote Clusters and Production
# Seed scripts and index sync refuse remote mongodb+srv clusters by default.
ALLOW_SEED_IN_PROD=false
ALLOW_SEED=0
ALLOW_INDEX_SYNC=0
ALLOW_CLEAN_DEMO=0

# Development Seeding (npm run seed:dev)
# Used only by the idempotent seed-dev script to initialize an admin user and campus
SEED_CAMPUS_NAME=Sample Collegiate University
SEED_CAMPUS_SLUG=sample-univ
SEED_CAMPUS_DOMAIN=sample.edu
SEED_USER_EMAIL=admin@sample.edu
SEED_USER_FULL_NAME=Campus Administrator
SEED_USER_PASSWORD=YourDevPassword123!

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth App Credentials (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
